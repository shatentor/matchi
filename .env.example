# Шаблон настроек Matchi: скопируйте в .env и заполните.
#   cp .env.example .env
# Сам .env под .gitignore и в репозиторий не попадает.
# Все значения читаются в config/settings.py.

# === Обязательное ===
# Токен от @BotFather. Без него падает уже импорт config/settings.py.
BOT_TOKEN=

# Telegram user id админа (узнать можно у @userinfobot).
# Несколько админов — через запятую БЕЗ пробелов: 123456789,987654321
# Без этого не работают /admin, /complains, жалобы и /support: уведомлять некого.
ADMIN_IDS=

# === PostgreSQL ===
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=match_bot

# === Redis (состояния FSM, очереди рулетки, троттлинг) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Поиск и антиспам ===
CANDIDATES_LIMIT=50
SUPPORT_COOLDOWN=120
BROADCAST_DELAY=0.05
MAX_USER_INTERESTS=5

# === Троттлинг входящих апдейтов ===
# Не больше THROTTLE_LIMIT апдейтов от одного пользователя за THROTTLE_WINDOW секунд.
THROTTLE_LIMIT=12
THROTTLE_WINDOW=10

# === Очередь исходящих (веерная рассылка в комнатах) ===
# Telegram допускает порядка 30 сообщений в секунду суммарно и не чаще
# одного в секунду в один и тот же чат — значения ниже держат запас.
OUTBOX_RATE=25
OUTBOX_PER_CHAT_INTERVAL=1.0
SEND_RETRY_ATTEMPTS=3

# === Комнаты по интересам ===
# Лимит участников небольшой намеренно: в режиме relay бот рассылает
# сообщения сам, а Telegram не даёт больше ~20 сообщений в минуту в один чат.
ROOM_MEMBER_LIMIT=30
ROOM_MAX_MESSAGE_LENGTH=700
ROOM_HISTORY_SIZE=15
# Срок жизни ссылки-приглашения в native-комнату, секунды.
ROOM_INVITE_TTL=3600

# === Рулетка и личные диалоги ===
ROULETTE_WAIT_TTL=600
DIALOG_HISTORY_SIZE=20

# === Посты и лента ===
# Лимит постов в сутки на человека спасает ленту от заваливания одним автором.
POST_MAX_TEXT_LENGTH=1500
POST_MAX_MEDIA=10
POST_MAX_COMMENT_LENGTH=700
POSTS_PER_DAY=10
FEED_COMMENTS_PREVIEW=5

# === Инвайты (вход в закрытую сеть только по коду) ===
# Длина кода, срок жизни в днях, сколько раз можно использовать один код
# и сколько активных кодов разрешено держать одному участнику.
INVITE_CODE_LENGTH=8
INVITE_TTL_DAYS=14
INVITE_MAX_USES=3
INVITES_PER_USER=5

# === Каталог участников и поиск ===
DIRECTORY_PAGE_SIZE=8
SEARCH_MIN_QUERY=2

# === Резервные копии базы ===
# Бинарники PostgreSQL не в PATH на этой машине, поэтому путь задаётся явно.
BACKUP_DIR=/home/nikita/.local/share/matchi-backups
BACKUP_KEEP=14
PG_BIN_DIR=/usr/lib/postgresql/16/bin
